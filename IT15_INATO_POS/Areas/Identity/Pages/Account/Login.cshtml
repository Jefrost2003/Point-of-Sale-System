@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - OOTD POS System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body>
    <div class="identity-wrapper">
        <div class="identity-card">
            <div class="identity-logo">
                <img src="~/images/ootd.png" alt="OOTD Logo" height="80"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                <div style="display: none;">
                    <i class="bi bi-shop" style="font-size: 4rem; color: #4F46E5;"></i>
                </div>
            </div>

            <h1 class="h3 fw-bold text-center mb-4" style="color: #1E293B;">Welcome Back</h1>

            <div id="recaptchaAlert" class="alert alert-warning small mb-3">
                <i class="bi bi-shield-lock me-2"></i>
                <strong>Security Notice:</strong> Please complete the security verification below to continue.
            </div>

            <form id="account" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Email Field with autocomplete -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" type="email"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email address</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Password Field with autocomplete -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" type="password"
                           placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        Remember me
                    </label>
                </div>

                <!-- reCAPTCHA Container -->
                <div class="mb-3 d-flex justify-content-center">
                    <div class="g-recaptcha" data-sitekey="6Ld7M7UsAAAAAKSMwxQVeqIT2TWHbFG8oaul-4I5" data-callback="onRecaptchaSuccess"></div>
                </div>

                <div id="recaptcha-status" class="text-center small mb-3"></div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 btn-lg" disabled
                        style="background: #4F46E5; border: none;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </button>

                <div class="text-center mt-3">
                    <a asp-page="./ForgotPassword" class="small" style="color: #4F46E5;">Forgot your password?</a>
                </div>
            </form>

            <div class="identity-footer">
                <p class="mb-0 text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Contact your system administrator to create an account.
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        let recaptchaToken = '';

        window.onRecaptchaSuccess = function(token) {
            recaptchaToken = token;
            $('#RecaptchaToken').remove();
            $('<input>').attr({
                type: 'hidden',
                name: 'Input.ReCaptchaToken',
                id: 'RecaptchaToken',
                value: token
            }).appendTo('#account');
            $('#recaptcha-status').html('<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Verification complete!</span>');
            $('#recaptchaAlert').removeClass('alert-warning').addClass('alert-success');
            $('#recaptchaAlert').html('<i class="bi bi-shield-check me-2"></i><strong>Verified!</strong>');
            $('#login-submit').prop('disabled', false);
        };

        window.onRecaptchaExpired = function() {
            recaptchaToken = '';
            $('#RecaptchaToken').remove();
            $('#recaptcha-status').html('<span class="text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i> Verification expired. Please complete again.</span>');
            $('#recaptchaAlert').removeClass('alert-success').addClass('alert-warning');
            $('#recaptchaAlert').html('<i class="bi bi-shield-lock me-2"></i><strong>Security Notice:</strong> Verification expired.');
            $('#login-submit').prop('disabled', true);
        };

        $(document).ready(function() {
            $('#account').on('submit', function(e) {
                if (!recaptchaToken || recaptchaToken.length === 0) {
                    e.preventDefault();
                    alert('Please complete the reCAPTCHA verification first.');
                    return false;
                }
                var submitBtn = $('#login-submit');
                submitBtn.prop('disabled', true);
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span>Verifying...');
                return true;
            });
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>