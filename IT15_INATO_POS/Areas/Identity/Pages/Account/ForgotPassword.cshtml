@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OOTD System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="identity-wrapper">
        <div class="identity-card">
            <!-- Logo -->
            <div class="identity-logo">
                <img src="~/images/ootd.png" alt="OOTD Logo" height="70"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" role="presentation" aria-hidden="true">
                <div style="display: none;">
                    <i class="bi bi-shop" style="font-size: 3.5rem; color: #4F46E5;"></i>
                </div>
            </div>

            <!-- Title -->
            <h1 class="h3 fw-bold text-center mb-2" style="color: #1E293B;">Forgot Password</h1>
            <p class="text-center text-muted mb-4">Enter your email to reset your password</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger text-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Form -->
            <div id="forgotPasswordForm" @(TempData["SuccessMessage"] != null ? "style=display:none" : "")>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" inputmode="email" type="email"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg" style="background: #4F46E5; border: none;">
                        <i class="bi bi-envelope me-2"></i>Send Reset Link
                    </button>
                </form>
            </div>

            <!-- Back to Login Link -->
            <div class="identity-footer mt-4">
                <p class="mb-0">
                    <a asp-page="./Login" class="text-decoration-none" style="color: #4F46E5;">
                        <i class="bi bi-arrow-left me-1"></i>Back to Login
                    </a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>