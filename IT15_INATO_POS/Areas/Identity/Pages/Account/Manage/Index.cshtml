@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="fade-in">
    <h3 class="fw-bold" style="color: #1E293B; border-bottom: 2px solid #e2e8f0; padding-bottom: 12px;">
        <i class="bi bi-person-circle me-2" style="color: #4F46E5;"></i>Profile Information
    </h3>

    <div class="row mt-4">
        <div class="col-md-12">
            <!-- Profile Update Form -->
            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="alert alert-info mb-4" style="background: #e0e7ff; border-color: #c7d2fe; color: #3730a3;">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> Contact your administrator to change your name or email.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #1E293B;">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input class="form-control bg-light" value="@Model.Username" disabled />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #1E293B;">First Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input class="form-control bg-light" value="@Model.FirstName" disabled />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #1E293B;">Last Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input class="form-control bg-light" value="@Model.LastName" disabled />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #1E293B;">Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input class="form-control bg-light" value="@Model.Email" disabled />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label fw-bold" style="color: #1E293B;">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Enter your phone number" />
                    </div>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Password Change Section -->
                <div class="mt-4 pt-3 border-top">
                    <h5 class="fw-bold" style="color: #1E293B;">
                        <i class="bi bi-key me-2" style="color: #4F46E5;"></i>Change Password
                    </h5>
                    <p class="text-muted small mb-3">Update your password here</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="InputPassword.OldPassword" class="form-label fw-bold" style="color: #1E293B;">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="InputPassword.OldPassword" class="form-control" type="password" />
                        </div>
                        <span asp-validation-for="InputPassword.OldPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InputPassword.NewPassword" class="form-label fw-bold" style="color: #1E293B;">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="InputPassword.NewPassword" class="form-control" type="password" />
                        </div>
                        <span asp-validation-for="InputPassword.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InputPassword.ConfirmPassword" class="form-label fw-bold" style="color: #1E293B;">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="InputPassword.ConfirmPassword" class="form-control" type="password" />
                        </div>
                        <span asp-validation-for="InputPassword.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4 mt-3">
                    <label class="form-label fw-bold" style="color: #1E293B;">Account Role</label>
                    <div class="p-3 bg-light rounded" style="background: #f8fafc !important;">
                        @if (Model.UserRoles != null && Model.UserRoles.Any())
                        {
                            foreach (var role in Model.UserRoles)
                            {
                                <span class="badge me-2 px-3 py-2" style="background: #4F46E5; font-size: 0.85rem;">
                                    <i class="bi bi-shield-check me-1"></i>@role
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No role assigned</span>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-grid">
                    <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg" style="background: #4F46E5; border: none; padding: 12px;">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}