<!-- PayMongo Payment Modal -->
<div class="modal fade" id="payMongoPaymentModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background: #4F46E5; color: white;">
                <h5 class="modal-title">
                    <i class="bi bi-credit-card me-2"></i>
                    <span id="paymentMethodTitle">Payment</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- GCash Payment Form -->
                <div id="gcashPaymentForm" style="display: none;">
                    <div class="text-center mb-4">
                        <div class="bg-light p-3 rounded-circle d-inline-block mb-3">
                            <i class="bi bi-phone" style="font-size: 2.5rem; color: #4F46E5;"></i>
                        </div>
                        <h5 class="fw-bold">GCash Payment</h5>
                        <p class="text-muted small">Enter your GCash account details</p>
                    </div>

                    <div class="alert alert-light border small p-3 mb-4">
                        <i class="bi bi-info-circle me-2" style="color: #4F46E5;"></i>
                        <strong>Test Mode:</strong> You can enter any valid details for testing
                    </div>

                    <form id="gcashForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Mobile Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">+63</span>
                                <input type="text" class="form-control" id="gcashMobile"
                                       placeholder="9XX XXX XXXX" maxlength="10" required>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-lightbulb me-1"></i>Example: 9171234567 or any 10-digit number
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">GCash PIN <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="gcashPin"
                                   placeholder="Enter 4-digit PIN" maxlength="4" required>
                            <small class="text-muted">
                                <i class="bi bi-lightbulb me-1"></i>Example: 1234 or any 4-digit PIN
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">OTP Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="gcashOtp"
                                   placeholder="Enter 6-digit OTP" maxlength="6" required>
                            <small class="text-muted">
                                <i class="bi bi-lightbulb me-1"></i>Example: 123456 or any 6-digit code
                            </small>
                        </div>

                        <div class="alert bg-light p-3 mb-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Amount to Pay:</span>
                            <span class="h4 mb-0 fw-bold" style="color: #4F46E5;" id="gcashAmount">₱0.00</span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg" style="background: #4F46E5; color: white; border: none;">
                                <i class="bi bi-check-circle me-2"></i>Confirm Payment
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Card Payment Form -->
                <div id="cardPaymentForm" style="display: none;">
                    <div class="text-center mb-4">
                        <div class="bg-light p-3 rounded-circle d-inline-block mb-3">
                            <i class="bi bi-credit-card-2-front" style="font-size: 2.5rem; color: #4F46E5;"></i>
                        </div>
                        <h5 class="fw-bold">Card Payment</h5>
                        <p class="text-muted small">Enter your card details</p>
                    </div>

                    <div class="alert alert-light border small p-3 mb-4">
                        <i class="bi bi-info-circle me-2" style="color: #4F46E5;"></i>
                        <strong>Test Mode:</strong> You can enter any valid card details for testing
                    </div>

                    <form id="cardForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Card Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardNumber"
                                   placeholder="4123 4567 8901 2346" maxlength="19" required>
                            <small class="text-muted">
                                <i class="bi bi-lightbulb me-1"></i>Example: 4123 4567 8901 2346 (13-19 digits)
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small">Expiry Date <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="cardExpiry"
                                       placeholder="MM/YY" maxlength="5" required>
                                <small class="text-muted">
                                    <i class="bi bi-lightbulb me-1"></i>Example: 12/30
                                </small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small">CVV <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="cardCvv"
                                       placeholder="123" maxlength="4" required>
                                <small class="text-muted">
                                    <i class="bi bi-lightbulb me-1"></i>Example: 123
                                </small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Cardholder Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardName"
                                   placeholder="JUAN DELA CRUZ" required>
                            <small class="text-muted">
                                <i class="bi bi-lightbulb me-1"></i>As shown on card
                            </small>
                        </div>

                        <div class="alert bg-light p-3 mb-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Amount to Pay:</span>
                            <span class="h4 mb-0 fw-bold" style="color: #4F46E5;" id="cardAmount">₱0.00</span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg" style="background: #4F46E5; color: white; border: none;">
                                <i class="bi bi-lock-fill me-2"></i>Pay Securely
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Processing State -->
                <div id="processingPayment" style="display: none;">
                    <div class="text-center py-5">
                        <div class="spinner-border mb-3" style="width: 3rem; height: 3rem; color: #4F46E5;" role="status">
                            <span class="visually-hidden">Processing...</span>
                        </div>
                        <h5 class="fw-bold">Processing Payment...</h5>
                        <p class="text-muted small">Please wait while we process your payment</p>
                        <div class="progress mt-3" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width: 100%; background: #4F46E5;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>