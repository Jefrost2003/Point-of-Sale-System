@model IT15_INATO_POS.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4 fade-in">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3" style="background: #c49a6c; color: white;">
                    <h4 class="mb-0"><i class="bi bi-info-circle me-2"></i>Product Details</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Main Product Image -->
                        <div class="col-md-4 mb-4">
                            <div class="position-relative">
                                <img src="@(Model.ImageUrl ?? "https://placehold.co/600x400/e9ecef/6c757d?text=No+Image")"
                                     class="img-fluid rounded shadow-sm" style="width: 100%; height: auto; object-fit: cover;"
                                     alt="@Model.ProductName">
                                @if (!Model.IsActive)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Active</span>
                                }
                            </div>
                        </div>

                        <!-- Product Info -->
                        <div class="col-md-8">
                            <h2 class="fw-bold mb-3" style="color: #212529;">@Model.ProductName</h2>
                            <div class="mb-3">
                                <span class="badge bg-secondary me-2">SKU: @Model.SKU</span>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </div>
                            <p class="lead mb-4">@Model.Description</p>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Total Variations:</strong></p>
                                    <p class="fs-4 mb-0 text-primary">@(Model.ProductVariations?.Count ?? 0)</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Total Stock:</strong></p>
                                    <p class="fs-4 mb-0 text-success">@(Model.ProductVariations?.Sum(pv => pv.StockLevel) ?? 0) units</p>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>Back to List
                                </a>
                                <a asp-action="Variations" asp-route-id="@Model.ProductID" class="btn btn-outline-info">
                                    <i class="bi bi-list-ul me-1"></i>Manage Variations
                                </a>
                                @if (User.IsInRole("Super Admin") || User.IsInRole("Inventory Clerk"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">
                                        <i class="bi bi-pencil me-1"></i>Edit Product
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Variations Section -->
                    <h5 class="fw-bold mb-3" style="color: #212529;">
                        <i class="bi bi-grid-3x3-gap me-2" style="color: #c49a6c;"></i>Available Variations
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Image</th>
                                    <th>Size</th>
                                    <th>Color</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ProductVariations != null && Model.ProductVariations.Any())
                                {
                                    @foreach (var variation in Model.ProductVariations)
                                    {
                                        <tr class="@(variation.IsLowStock ? "table-warning" : "")">
                                            <td>
                                                @if (!string.IsNullOrEmpty(variation.ImageUrl))
                                                {
                                                    <img src="@variation.ImageUrl" alt="@variation.Color"
                                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px; border: 1px solid #dee2e6;">
                                                }
                                                else
                                                {
                                                    <img src="@(Model.ImageUrl ?? "https://placehold.co/600x400/e9ecef/6c757d?text=No+Image")"
                                                         alt="No image"
                                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px; border: 1px solid #dee2e6; opacity: 0.6;">
                                                }
                                            </td>
                                            <td><span class="badge bg-secondary">@variation.Size</span></td>
                                            <td><span class="badge" style="background: #e9ecef; color: #212529;">@variation.Color</span></td>
                                            <td class="fw-bold" style="color: #c49a6c;">₱@variation.Price.ToString("N2")</td>
                                            <td>
                                                @if (variation.IsLowStock)
                                                {
                                                    <span class="text-danger fw-bold">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>@variation.StockLevel
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-success fw-bold">@variation.StockLevel</span>
                                                }
                                            </td>
                                            <td>
                                                @if (variation.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <i class="bi bi-inbox" style="font-size: 2rem; color: #c49a6c; opacity: 0.5;"></i>
                                            <p class="text-muted mt-2">No variations available for this product.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>