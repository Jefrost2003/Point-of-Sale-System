@model IEnumerable<IT15_INATO_POS.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="fade-in">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: #1E293B;">Products</h1>
            <p class="text-secondary mb-0">Manage your product catalog</p>
        </div>
        @if (User.IsInRole("Super Admin") || User.IsInRole("Inventory Clerk"))
        {
            <a asp-action="Create" class="btn btn-primary mt-2 mt-sm-0" style="background: #4F46E5; border: none;">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        }
    </div>

    <!-- Products Grid -->
    <div class="row g-3 g-md-4">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card product-card h-100 border">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.ProductName" class="product-image"
                             style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px 8px 0 0;"
                             referrerpolicy="no-referrer"
                             loading="lazy">
                    }
                    else
                    {
                        <div class="product-image-placeholder" style="width: 100%; height: 180px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; border-radius: 8px 8px 0 0;">
                            <i class="bi bi-image text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: #1E293B;">@product.ProductName</h5>
                        <p class="text-secondary small mb-2">SKU: @product.SKU</p>
                        <p class="small text-secondary text-truncate">@product.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="badge" style="background: #4F46E5;">@product.ProductVariations?.Count variations</span>
                            <span class="badge" style="background: #10B981;">@product.ProductVariations?.Sum(pv => pv.StockLevel) in stock</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2 border-0 pt-0">
                        <a asp-action="Details" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-secondary flex-grow-1">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a asp-action="Variations" asp-route-id="@product.ProductID" class="btn btn-sm" style="background: #4F46E5; color: white;">
                            <i class="bi bi-list-ul"></i>
                        </a>
                        @if (User.IsInRole("Super Admin") || User.IsInRole("Inventory Clerk"))
                        {
                            <a asp-action="Edit" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }

    .product-image {
        background: #f8fafc;
    }
</style>