@using Microsoft.AspNetCore.Identity
@using IT15_INATO_POS.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - OOTD POS System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <nav class="navbar navbar-expand-lg sticky-top" style="background: white; border-bottom: 2px solid #4F46E5; padding: 0.5rem 1rem; position: sticky; top: 0; z-index: 1000; width: 100%;">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ootd.png" alt="OOTD Logo" height="40" style="object-fit: contain;" />
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>

                        @if (User.IsInRole("Super Admin") || User.IsInRole("Cashier"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "POS" ? "active" : "")"
                                   asp-controller="POS" asp-action="Index">
                                    <i class="bi bi-cart-check me-1"></i>POS
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Super Admin") || User.IsInRole("Inventory Clerk") || User.IsInRole("Store Manager") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
                                   asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i>Products
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Store Manager"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-bar-chart-line me-1"></i>Reports
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Sales"><i class="bi bi-cash-stack me-2"></i>Sales Report</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Inventory"><i class="bi bi-boxes me-2"></i>Inventory Report</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="LowStock"><i class="bi bi-exclamation-triangle me-2"></i>Low Stock Alert</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="TopSelling"><i class="bi bi-trophy me-2"></i>Top Selling</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Transactions"><i class="bi bi-receipt me-2"></i>Transactions</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Super Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear-fill me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-people me-2"></i>User Management</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="AuditLogs"><i class="bi bi-file-text me-2"></i>Audit Logs</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="SecurityLogs"><i class="bi bi-shield-lock me-2"></i>Security Logs</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="SystemLogs"><i class="bi bi-gear me-2"></i>System Logs</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Archived"><i class="bi bi-archive me-2"></i>Archive</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

        <div class="container-fluid mt-3 mt-md-4" style="flex: 1;">
            <main role="main" class="pb-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>

        <footer class="footer mt-auto" style="background: white; border-top: 1px solid #E2E8F0; padding: 1rem 0; width: 100%;">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <small class="text-secondary">&copy; 2026 OOTD POS System - Jefford Inato</small>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <small><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-secondary">Privacy Policy</a></small>
                    </div>
                </div>
            </div>
        </footer>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>