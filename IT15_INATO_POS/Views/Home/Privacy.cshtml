@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <h1 class="display-6 fw-bold mb-4">@ViewData["Title"]</h1>

                    <p class="lead">OOTD System is committed to protecting your privacy and ensuring the security of your personal information.</p>

                    <hr class="my-4">

                    <h4 class="fw-bold mt-4">Information Collection</h4>
                    <p>We collect information necessary for the operation of our Point of Sale and Inventory Management System, including:</p>
                    <ul>
                        <li>User account information (name, email, role)</li>
                        <li>Transaction data</li>
                        <li>Product and inventory information</li>
                        <li>System usage logs</li>
                    </ul>

                    <h4 class="fw-bold mt-4">Data Security</h4>
                    <p>We implement industry-standard security measures to protect your data, including:</p>
                    <ul>
                        <li>Encrypted database connections</li>
                        <li>Role-based access control</li>
                        <li>Secure authentication using ASP.NET Core Identity</li>
                        <li>Audit logging for all system activities</li>
                    </ul>

                    <h4 class="fw-bold mt-4">Third-Party Services</h4>
                    <p>Our system integrates with the following third-party services:</p>
                    <ul>
                        <li><strong>PayMongo:</strong> For secure payment processing</li>
                        <li><strong>CraftMyPDF:</strong> For receipt generation</li>
                    </ul>

                    <h4 class="fw-bold mt-4">Contact Information</h4>
                    <p>For questions about this privacy policy or our data practices, please contact:</p>
                    <p class="mb-0"><strong>Jefford Inato</strong><br>Email: jeffordinato@ootd.com</p>
                </div>
            </div>
        </div>
    </div>
</div>